{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qa-report.schema.json",
  "title": "QA Report",
  "description": "Schema for a QA report summarizing test results, coverage, and playtest findings for a feature.",
  "type": "object",
  "required": [
    "feature_id", "test_results", "coverage",
    "missing_tests", "playtest", "recommendation", "created_at"
  ],
  "properties": {
    "feature_id": {
      "type": "string",
      "description": "Reference to a feature ID (category.name format)"
    },
    "test_results": {
      "type": "array",
      "items": { "$ref": "#/definitions/testResult" }
    },
    "coverage": {
      "type": "object",
      "required": ["total", "passing", "failing", "skipped"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "passing": { "type": "integer", "minimum": 0 },
        "failing": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "missing_tests": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Descriptions of tests that should exist but are missing"
    },
    "playtest": {
      "type": "object",
      "required": ["completed", "notes", "issues"],
      "properties": {
        "completed": { "type": "boolean" },
        "notes": { "type": "string" },
        "issues": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "recommendation": {
      "type": "string",
      "enum": ["APPROVE", "REJECT", "NEEDS_WORK"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "testResult": {
      "type": "object",
      "required": ["name", "type", "status"],
      "properties": {
        "name": { "type": "string" },
        "type": {
          "type": "string",
          "description": "Test type, e.g. unit, integration, playtest"
        },
        "status": {
          "type": "string",
          "enum": ["PASS", "FAIL", "SKIP"]
        },
        "details": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
