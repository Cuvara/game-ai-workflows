{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "implementation-plan.schema.json",
  "title": "Implementation Plan",
  "description": "Schema for a feature implementation plan covering architecture, changes, risks, and testing.",
  "type": "object",
  "required": [
    "feature_id", "feature_name", "current_architecture",
    "affected_systems", "new_systems", "changes", "dependencies",
    "migration", "tests", "risks", "acceptance_criteria",
    "implementation_order", "estimated_complexity"
  ],
  "properties": {
    "feature_id": {
      "type": "string",
      "description": "Reference to a feature ID (category.name format)"
    },
    "feature_name": {
      "type": "string"
    },
    "current_architecture": {
      "type": "string",
      "description": "Description of the current architecture relevant to this feature"
    },
    "affected_systems": {
      "type": "array",
      "items": { "type": "string" }
    },
    "new_systems": {
      "type": "array",
      "items": { "type": "string" }
    },
    "changes": {
      "type": "array",
      "items": { "$ref": "#/definitions/fileChange" }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "migration": {
      "type": "object",
      "required": ["required", "steps"],
      "properties": {
        "required": { "type": "boolean" },
        "steps": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "tests": {
      "type": "array",
      "items": { "$ref": "#/definitions/testEntry" }
    },
    "risks": {
      "type": "array",
      "items": { "$ref": "#/definitions/riskEntry" }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "implementation_order": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Ordered list of steps or sub-tasks for implementation"
    },
    "estimated_complexity": {
      "type": "string",
      "enum": ["trivial", "small", "medium", "large", "epic"]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "fileChange": {
      "type": "object",
      "required": ["file", "description", "type"],
      "properties": {
        "file": { "type": "string" },
        "description": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["ADD", "MODIFY", "DELETE"]
        }
      },
      "additionalProperties": false
    },
    "testEntry": {
      "type": "object",
      "required": ["description", "type"],
      "properties": {
        "description": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["unit", "integration", "playtest"]
        }
      },
      "additionalProperties": false
    },
    "riskEntry": {
      "type": "object",
      "required": ["description", "severity", "mitigation"],
      "properties": {
        "description": { "type": "string" },
        "severity": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "mitigation": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
