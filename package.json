{
  "name": "game-ai-workflows",
  "version": "1.0.0",
  "description": "Portable AI-agent-agnostic Game Design → Feature → Development → QA workflow framework",
  "type": "module",
  "bin": {
    "game-ai-workflows": "bin/cli.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/",
    "providers/",
    "schemas/",
    "contracts/",
    "skills/",
    "adapters/",
    "agents/",
    "docs/",
    ".claude/"
  ],
  "scripts": {
    "bootstrap": "node scripts/bootstrap/bootstrap.mjs",
    "validate": "node scripts/validate/validate.mjs",
    "test": "node --test tests/**/*.test.mjs",
    "test:registry": "node --test tests/registry/*.test.mjs",
    "test:validation": "node --test tests/validation/*.test.mjs",
    "test:bootstrap": "node --test tests/bootstrap/*.test.mjs",
    "test:workflows": "node --test tests/workflows/*.test.mjs",
    "mcp": "node src/mcp-server.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "game-design",
    "gdd",
    "workflow",
    "feature-management",
    "ai-agent",
    "design-sync",
    "mcp",
    "claude-code",
    "codex"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cuvara/game-ai-workflows.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
